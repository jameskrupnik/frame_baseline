# Generated platform scaffolding for the example app. Regenerate with:
#   cd example && flutter create --platforms=ios,android,macos .
example/ios/
example/android/
example/macos/
example/windows/
example/linux/
example/web/

# Captured device logs are scratch input to the comparator, and the HTML report
# is regenerated in full on every run. The committed goldens under
# example/perf/baselines/ and the append-only history are what belong in git.
*.log
**/perf/report.html

